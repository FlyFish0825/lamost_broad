{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "OpenOCD Flash STM32",
            "type": "shell",
            "dependsOn": "Build STM32",
            "dependsOrder": "sequence",
            "command": "C:\\Program Files\\openOCD\\bin\\openocd.exe",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f3x.cfg",
                "-c",
                "program build/Debug/lamost_broad_MCU.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Clean Rebuild STM32",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/Debug",
                "--clean-first"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}